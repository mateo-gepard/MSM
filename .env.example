# Public site URL used for absolute metadata and auth callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings. Keep the service-role key server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cal.com v2 API. Map every stable tutor slug to its event type ID.
CALCOM_API_KEY=YOUR_CALCOM_API_KEY
CALCOM_EVENT_TYPE_IDS_JSON={"juan-rivera-chopinaud":101,"mateo-mamaladze":102,"roman-daugavet":103,"len-sobol":104,"johannes-jacob":105}
# Optional fallback only when every tutor intentionally shares one event type.
# CALCOM_DEFAULT_EVENT_TYPE_ID=101

# Sendbird credentials are consumed only by server routes. Never expose the API token.
SENDBIRD_APP_ID=YOUR_SENDBIRD_APP_ID
SENDBIRD_API_TOKEN=YOUR_SENDBIRD_API_TOKEN
