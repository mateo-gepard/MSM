# Canonical application origin used for metadata, auth redirects, and provider callbacks.
# Production must be HTTPS. Do not include a path, query string, or credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings. Keep the service-role key server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# HMAC key for privacy-preserving, database-backed API rate-limit identities.
# Use at least 32 random characters in production.
RATE_LIMIT_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# New Checkout creation is fail-closed. Keep both sales gates false until legal approval,
# Stripe test-mode verification, signed webhook verification, and offer publication are complete.
# These flags do not disable the signed Stripe webhook; keep its credentials configured.
PAYMENTS_ENABLED=false
PAYMENTS_LEGAL_APPROVED=false
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Cal.com v2 API. Map every stable tutor slug to its event type ID and configure
# the signed webhook endpoint at /api/webhooks/calcom.
CALCOM_API_KEY=YOUR_CALCOM_API_KEY
CALCOM_EVENT_TYPE_IDS_JSON={"juan-rivera-chopinaud":101,"mateo-mamaladze":102,"roman-daugavet":103,"len-sobol":104,"johannes-jacob":105}
# Optional fallback only when every tutor intentionally shares one event type.
# CALCOM_DEFAULT_EVENT_TYPE_ID=101
# Production rejects placeholders and values shorter than 32 UTF-8 bytes.
CALCOM_WEBHOOK_SECRET=YOUR_CALCOM_WEBHOOK_SIGNING_SECRET

# Require AAL2 for tutor/admin operations. Keep enabled outside isolated local testing.
REQUIRE_STAFF_MFA=true

# Bearer secret for the scheduled /api/cron/reconcile-bookings request in vercel.json.
# Generate at least 32 random UTF-8 bytes and keep it server-side only.
# Production rejects this placeholder and weak values.
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
